   "lineHeight": 1.28,
   "autoResize": true
  },
  {
   "id": "text-66",
   "type": "text",
   "x": 245.9,
   "y": 580.6,
   "width": 768.3,
   "height": 35.8,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1663617495,
   "version": 1,
   "versionNonce": 1005313354,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "um evento de 2022 que chega hoje é posicionado pelo timestamp do fato — não pela ordem de chegada.\nDados raramente são alterados: o ciclo de vida é baseado em retenção e sumarização (downsampling).",
   "originalText": "um evento de 2022 que chega hoje é posicionado pelo timestamp do fato — não pela ordem de chegada.\nDados raramente são alterados: o ciclo de vida é baseado em retenção e sumarização (downsampling).",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.28,
   "autoResize": true
  },
  {
   "id": "text-67",
   "type": "text",
   "x": 168,
   "y": 680.4,
   "width": 924,
   "height": 19.2,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1573825569,
   "version": 1,
   "versionNonce": 666621708,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Série temporal é um conceito independente do banco: importa o tempo como eixo central e a leitura por janelas.",
   "originalText": "Série temporal é um conceito independente do banco: importa o tempo como eixo central e a leitura por janelas.",
