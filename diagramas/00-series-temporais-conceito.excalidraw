   "link": null,
   "locked": false,
   "text": "ordem lógica pelo timestamp  ·  escrita append-only  ·  chegada fora de ordem (out-of-order)",
   "originalText": "ordem lógica pelo timestamp  ·  escrita append-only  ·  chegada fora de ordem (out-of-order)",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
